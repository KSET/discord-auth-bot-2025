# This file is only for the one-time legacy users-table import.
# Use the same old PostgreSQL connection values that were in OldDiscordBot/.env.db.
OLD_POSTGRES_HOST=
OLD_POSTGRES_PORT=5432
OLD_POSTGRES_DB=
OLD_POSTGRES_USER=
OLD_POSTGRES_PASSWORD=
# Keep "prefer" for PostgreSQL on this Docker host's private networks.
OLD_POSTGRES_SSLMODE=prefer

# Registar's PostgreSQL service as reachable from its Docker network.
REGISTAR_POSTGRES_HOST=db
REGISTAR_POSTGRES_PORT=5432
REGISTAR_POSTGRES_DB=
REGISTAR_POSTGRES_USER=
REGISTAR_POSTGRES_PASSWORD=
REGISTAR_POSTGRES_SSLMODE=prefer

# Existing external Docker networks. Adjust the Registar name to the network
# created by the deployment's Compose project.
LEGACY_DB_DOCKER_NETWORK=verifikatorMreza
REGISTAR_DOCKER_NETWORK=registar_default
